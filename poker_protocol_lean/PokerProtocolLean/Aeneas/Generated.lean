def reveal_token_proof.RevealTokenProof.verify
  {C : Type} {T1 : Type} {Clause0_Point : Type} {Clause0_Scalar : Type}
  {Clause0_Clause6_Compressed : Type} (poker_protocol_corecurveCurveInst :
  poker_protocol_core.curve.Curve C Clause0_Point Clause0_Scalar
  Clause0_Clause6_Compressed)
  (poker_protocol_coretranscriptCryptoTranscriptInst :
  poker_protocol_core.transcript.CryptoTranscript T1)
  (self : reveal_token_proof.RevealTokenProof C Clause0_Point Clause0_Scalar
  Clause0_Clause6_Compressed)
  (encrypted_card : poker_protocol_core.curve.ElGamalCiphertextGeneric C
  Clause0_Point Clause0_Scalar Clause0_Clause6_Compressed)
  (reveal_token : Clause0_Point) (expected_pk : Clause0_Point)
  (transcript : T1) :
  Result ((core.result.Result Unit reveal_token_proof.RevealProofError) × T1)
  := do
  let b ←
    poker_protocol_core.curve.ElGamalCiphertextGeneric.is_valid
      poker_protocol_corecurveCurveInst encrypted_card
  if b
  then
    let b1 ←
      poker_protocol_corecurveCurveInst.CurvePointInst.is_identity expected_pk
    if b1
    then
      ok (core.result.Result.Err
        reveal_token_proof.RevealProofError.InvalidProof, transcript)
    else
      let b2 ←
        poker_protocol_corecurveCurveInst.CurvePointInst.is_identity
          self.user_public_key
      if b2
      then
        ok (core.result.Result.Err
          reveal_token_proof.RevealProofError.InvalidProof, transcript)
      else
        let b3 ←
          poker_protocol_corecurveCurveInst.CurvePointInst.is_identity
            reveal_token
        if b3
        then
          ok (core.result.Result.Err
            reveal_token_proof.RevealProofError.InvalidProof, transcript)
        else
          let b4 ←
            poker_protocol_corecurveCurveInst.CurvePointInst.corecmpPartialEqInst.ne
              self.user_public_key expected_pk
          if b4
          then
            ok (core.result.Result.Err
              reveal_token_proof.RevealProofError.InvalidProof, transcript)
          else
            let b5 ←
              poker_protocol_corecurveCurveInst.CurvePointInst.is_identity
                self.commitment_t1
            if b5
            then
              ok (core.result.Result.Err
                reveal_token_proof.RevealProofError.InvalidProof, transcript)
            else
              let b6 ←
                poker_protocol_corecurveCurveInst.CurvePointInst.is_identity
                  self.commitment_t2
              if b6
              then
                ok (core.result.Result.Err
                  reveal_token_proof.RevealProofError.InvalidProof, transcript)
              else
                let (expected_c, transcript1) ←
                  reveal_token_proof.RevealTokenProof.compute_challenge
                    poker_protocol_corecurveCurveInst
                    poker_protocol_coretranscriptCryptoTranscriptInst
                    self.user_public_key encrypted_card reveal_token
                    self.commitment_t1 self.commitment_t2 self.nonce transcript
                let t ← poker_protocol_corecurveCurveInst.base_g
                let lhs_g ←
                  poker_protocol_corecurveCurveInst.CurvePointInst.coreopsarithMulInst.mul
                    t self.response_s
                let t1 ←
                  poker_protocol_corecurveCurveInst.CurvePointInst.coreopsarithMulInst.mul
                    self.user_public_key expected_c
                let rhs_g ←
                  poker_protocol_corecurveCurveInst.CurvePointInst.coreopsarithAddInst.add
                    self.commitment_t1 t1
                let b7 ←
                  poker_protocol_corecurveCurveInst.CurvePointInst.corecmpPartialEqInst.ne
                    lhs_g rhs_g
                if b7
                then
                  ok (core.result.Result.Err
                    reveal_token_proof.RevealProofError.InvalidProof,
                    transcript1)
                else
                  let lhs_ct ←
                    poker_protocol_corecurveCurveInst.CurvePointInst.coreopsarithMulInst.mul
                      encrypted_card.c1 self.response_s
                  let t2 ←
                    poker_protocol_corecurveCurveInst.CurvePointInst.coreopsarithMulInst.mul
                      reveal_token expected_c
                  let rhs_ct ←
                    poker_protocol_corecurveCurveInst.CurvePointInst.coreopsarithAddInst.add
                      self.commitment_t2 t2
                  let b8 ←
                    poker_protocol_corecurveCurveInst.CurvePointInst.corecmpPartialEqInst.ne
                      lhs_ct rhs_ct
                  if b8
                  then
                    ok (core.result.Result.Err
                      reveal_token_proof.RevealProofError.InvalidProof,
                      transcript1)
                  else ok (core.result.Result.Ok (), transcript1)
  else
    ok (core.result.Result.Err
      reveal_token_proof.RevealProofError.InvalidElGamalStructure, transcript)

