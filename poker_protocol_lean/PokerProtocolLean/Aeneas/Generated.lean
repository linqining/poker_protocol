  (encrypted_card : poker_protocol_core.curve.ElGamalCiphertextGeneric C
  Clause0_Point Clause0_Scalar Clause0_Clause6_Compressed)
  (reveal_token : Clause0_Point) (t1 : Clause0_Point) (t2 : Clause0_Point)
  (nonce : Clause0_Scalar) (transcript : T1) :
  Result (Clause0_Scalar × T1)
  := do
  let s ←
    lift (Array.to_slice
      (Array.make 18#usize [
        114#u8, 101#u8, 118#u8, 101#u8, 97#u8, 108#u8, 95#u8, 116#u8, 111#u8,
        107#u8, 101#u8, 110#u8, 95#u8, 110#u8, 111#u8, 110#u8, 99#u8, 101#u8
        ]))
  let transcript1 ←
    poker_protocol_coretranscriptCryptoTranscriptInst.append_scalar
      poker_protocol_corecurveCurveInst transcript s nonce
  let s1 ← lift (Array.to_slice (Array.make 2#usize [ 112#u8, 107#u8 ]))
  let transcript2 ←
    poker_protocol_coretranscriptCryptoTranscriptInst.append_point
      poker_protocol_corecurveCurveInst transcript1 s1 pk
  let s2 ← lift (Array.to_slice (Array.make 2#usize [ 99#u8, 49#u8 ]))
  let transcript3 ←
    poker_protocol_coretranscriptCryptoTranscriptInst.append_point
