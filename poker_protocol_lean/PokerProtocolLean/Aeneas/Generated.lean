            poker_protocol_corecurveCurveInst.CurvePointInst.coreopsarithAddInst.add
              mask_card.c2 t3
          let b4 ←
            poker_protocol_core.curve.ElGamalCiphertextGeneric.is_valid
              poker_protocol_corecurveCurveInst { mask_card with c2 := t4 }
          if b4
          then ok (core.result.Result.Ok { mask_card with c2 := t4 }, _rng)
          else
            ok (core.result.Result.Err
              poker_protocol_core.error.VerificationError.InvalidCiphertext,
