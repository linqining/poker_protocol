  let s3 ← lift (Array.to_slice (Array.make 2#usize [ 99#u8, 50#u8 ]))
  let transcript4 ←
    poker_protocol_coretranscriptCryptoTranscriptInst.append_point
      poker_protocol_corecurveCurveInst transcript3 s3 encrypted_card.c2
  let s4 ←
    lift (Array.to_slice
      (Array.make 12#usize [
        114#u8, 101#u8, 118#u8, 101#u8, 97#u8, 108#u8, 95#u8, 116#u8, 111#u8,
        107#u8, 101#u8, 110#u8
        ]))
  let transcript5 ←
    poker_protocol_coretranscriptCryptoTranscriptInst.append_point
      poker_protocol_corecurveCurveInst transcript4 s4 reveal_token
  let s5 ← lift (Array.to_slice (Array.make 2#usize [ 116#u8, 49#u8 ]))
  let transcript6 ←
    poker_protocol_coretranscriptCryptoTranscriptInst.append_point
      poker_protocol_corecurveCurveInst transcript5 s5 t1
  let s6 ← lift (Array.to_slice (Array.make 2#usize [ 116#u8, 50#u8 ]))
