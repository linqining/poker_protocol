  (pk : Clause0_Point) (_rng : T1) :
  Result ((core.result.Result
    (poker_protocol_core.curve.ElGamalCiphertextGeneric C Clause0_Point
    Clause0_Scalar Clause0_Clause6_Compressed)
    poker_protocol_core.error.VerificationError) × T1)
  := do
  let b ←
    poker_protocol_core.curve.ElGamalCiphertextGeneric.is_valid
      poker_protocol_corecurveCurveInst ct
