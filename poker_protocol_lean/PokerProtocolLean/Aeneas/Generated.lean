        let t1 ← poker_protocol_corecurveCurveInst.base_g
        let t2 ←
          poker_protocol_corecurveCurveInst.CurvePointInst.coreopsarithMulInst.mul
            t1 sk
        let b3 ←
          poker_protocol_corecurveCurveInst.CurvePointInst.corecmpPartialEqInst.ne
            pk t2
        if b3
        then
          ok (core.result.Result.Err
            poker_protocol_core.error.VerificationError.InvalidPublicKey, _rng)
        else
          let mask_card ←
            poker_protocol_core.curve.ElGamalCiphertextGeneric.Insts.CoreCloneClone.clone
              poker_protocol_corecurveCurveInst.corecloneCloneInst
              poker_protocol_corecurveCurveInst
              poker_protocol_corecurveCurveInst.CurvePointInst.corecloneCloneInst
              ct
          let t3 ←
            poker_protocol_corecurveCurveInst.CurvePointInst.coreopsarithMulInst.mul
              mask_card.c1 sk
